# Copy to .env at checkout root; never commit credentials.
# `uv run python main.py` in infra/cdktn/tailscale reads literal assignments;
# inherited env wins. Use --env-file /private/path.env or --no-env to select
# another source.

# Administrator only: OAuth policy provisioner for ensure/import/plan/apply.
TAILSCALE_TAILNET=example.ts.net
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# Host only: user-owned API access token for From > Create network invitation.
# The host may instead store this in its secure UI credential storage.
# The infrastructure manager strips this token from its provider environment.
TAILSCALE_API_KEY=
